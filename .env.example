# WorkOS
# WorkOS client ID (required)
WORKOS_CLIENT_ID=
# WorkOS API key (required)
WORKOS_API_KEY=
# AuthKit callback URL (required)
WORKOS_REDIRECT_URI=
# Session cookie encryption password (at least 32 characters) (required)
WORKOS_COOKIE_PASSWORD=
# WorkOS API hostname
WORKOS_API_HOSTNAME=

# Groq (server-only; never expose through VITE_*)
GROQ_API_KEY=
# 32-byte base64/hex secret used to encrypt per-user Groq keys at rest
GROQ_CREDENTIAL_ENCRYPTION_KEY=

# Neon Postgres
DATABASE_URL=
